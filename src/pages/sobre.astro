---
import { Image } from 'astro:assets';
import cover from '@/assets/images/podcast-cover.webp';
import Icon from '@/components/ui/Icon.astro';
import { about } from '@/config/about';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profileSchema } from '@/lib/schema';
---

<BaseLayout
  title="Sobre"
  description="Sobre o podcast Azar Cósmico e o anfitrião João Guilherme Matos: comédia, improviso, cultura e crónicas de humor."
  type="profile"
  structuredData={profileSchema('/sobre/')}
>
  <header class="shell grid gap-12 pt-16 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16">
    <div>
      <p class="rise eyebrow">{about.eyebrow}</p>
      <h1 class="rise mt-6 max-w-[18ch] text-headline" style="--rise-step: 1">
        {about.title} <span class="serif">{about.highlight}</span>
      </h1>
      <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
        {about.text}
      </p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
        <a class="btn btn-primary" href="/episodios/">
          Ouvir episódios
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={`mailto:${siteConfig.author.email}`}>
          Contactar
        </a>
      </div>
    </div>
    <div class="rise relative" style="--rise-step: 2">
      <Image
        src={cover}
        alt={about.portraitAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 64rem) 22rem, 90vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-square w-full rounded-card object-cover"
      />
      <p class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-surface/90 px-3.5 py-1.5 text-sm font-medium backdrop-blur">
        <Icon name="map-pin" class="size-3.5" />
        {siteConfig.author.location}
      </p>
    </div>
  </header>

  <div class="shell mt-20 sm:mt-28">
    {about.sections.map((section) => (
      <section class="reveal grid gap-6 border-t border-line py-12 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16">
        <h2 class="eyebrow self-start">{section.title}</h2>
        <div class="grid max-w-3xl gap-5 text-lead text-body">
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="shell mt-16 sm:mt-24" aria-labelledby="follow-title">
    <h2 id="follow-title" class="reveal text-section">
      {about.principles.title}
    </h2>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {about.principles.items.map((item, index) => (
        <li class="reveal">
          <a
            href={item.href}
            target="_blank"
            rel="noopener"
            class="group block h-full rounded-card border border-line bg-surface p-7 transition-colors hover:border-ink"
          >
            <span class="font-serif text-3xl text-muted italic" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-8 flex items-center gap-2 text-title">
              {item.title}
              <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4 text-muted" />
            </h3>
            <p class="mt-3 text-muted">{item.text}</p>
            <span class="sr-only">(abre numa nova aba)</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
