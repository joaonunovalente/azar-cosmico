---
import VideoCard from '@/components/podcast/VideoCard.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Pagination from '@/components/ui/Pagination.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getVideos, videosPageHref, videosPageSize } from '@/lib/podcast';

export async function getStaticPaths() {
  const videos = await getVideos();
  const total = Math.ceil(videos.length / videosPageSize);

  return Array.from({ length: Math.max(total - 1, 0) }, (_, index) => {
    const current = index + 2;
    return {
      params: { page: String(current) },
      props: {
        current,
        total,
        videos: videos.slice((current - 1) * videosPageSize, current * videosPageSize),
      },
    };
  });
}

const { videos, current, total } = Astro.props;
const title = `Vídeos, página ${current} de ${total}`;
---

<BaseLayout
  title={title}
  description={`Clips e sketches do Azar Cósmico no YouTube, página ${current} de ${total}.`}
  prevUrl={current > 1 ? videosPageHref(current - 1) : undefined}
  nextUrl={current < total ? videosPageHref(current + 1) : undefined}
>
  <PageHero eyebrow={`Arquivo, página ${current}`} title="Os melhores momentos em" highlight="vídeo." />

  <section class="shell mt-16 sm:mt-20" aria-label="Vídeos">
    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      {videos.map((video) => (
        <VideoCard video={video} headingLevel="h2" />
      ))}
    </div>
    <Pagination current={current} total={total} hrefFor={videosPageHref} />
  </section>
</BaseLayout>
