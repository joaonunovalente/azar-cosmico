---
import PageHero from '@/components/ui/PageHero.astro';
import { changelog } from '@/config/changelog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbs } from '@/lib/schema';
import { formatDate } from '@/lib/podcast';
import Icon from '@/components/ui/Icon.astro';
---

<BaseLayout
  title="Registo de Alterações"
  description="Registo de alterações do site do Azar Cósmico: descrição das mudanças implementadas."
  noindex
  closing={false}
  structuredData={{
    '@context': 'https://schema.org',
    ...breadcrumbs([
      { name: 'Início', href: '/' },
      { name: 'Registo de Alterações', href: '/registo-de-alteracoes/' },
    ]),
  }}
>
  <PageHero eyebrow="Legal" title="Registo de Alterações">
    <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
      O que mudou no site do Azar Cósmico. O{' '}
      <a
        class="link inline-flex items-center gap-1.5"
        href="https://github.com/joaonunovalente/azar-cosmico"
        target="_blank"
        rel="noopener"
      >
        código-fonte
        <Icon name="arrow-up-right" class="size-3.5" />
      </a>{' '}
      está disponível para consulta.
    </p>
  </PageHero>
  <section class="shell mt-16 sm:mt-20" aria-label="Registo de alterações">
    <ol class="grid gap-0">
      {changelog.map((entry) => (
        <li class="reveal grid gap-3 border-t border-line py-10 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16">
          <div class="grid content-start gap-2 self-start">
            <h2 class="text-title">{entry.version}</h2>
            <p class="text-sm text-muted">
              <time datetime={entry.date}>{formatDate(entry.date)}</time>
            </p>
          </div>
          <div class="max-w-3xl">
            <h3 class="text-title">{entry.title}</h3>
            {Array.isArray(entry.text) ? (
              entry.text.map((paragraph) => <p class="mt-3 text-lead text-body">{paragraph}</p>)
            ) : (
              <p class="mt-3 text-lead text-body">{entry.text}</p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
