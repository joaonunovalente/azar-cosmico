---
import PostCard from '@/components/podcast/PostCard.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Pagination from '@/components/ui/Pagination.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { postsPageHref, postsPageSize, getPosts } from '@/lib/podcast';

export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / postsPageSize);

  return Array.from({ length: Math.max(total - 1, 0) }, (_, index) => {
    const current = index + 2;
    return {
      params: { page: String(current) },
      props: {
        current,
        total,
        posts: posts.slice((current - 1) * postsPageSize, current * postsPageSize),
      },
    };
  });
}

const { posts, current, total } = Astro.props;
const title = `Blog, página ${current} de ${total}`;
---

<BaseLayout
  title={title}
  description={`Crónicas de humor do Azar Cósmico, página ${current} de ${total}.`}
  prevUrl={current > 1 ? postsPageHref(current - 1) : undefined}
  nextUrl={current < total ? postsPageHref(current + 1) : undefined}
>
  <PageHero eyebrow={`Arquivo, página ${current}`} title="Crónicas de humor do" highlight="Azar Cósmico." />

  <section class="shell mt-16 sm:mt-20" aria-label="Crónicas">
    <div class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} headingLevel="h2" />
      ))}
    </div>
    <Pagination current={current} total={total} hrefFor={postsPageHref} />
  </section>
</BaseLayout>
