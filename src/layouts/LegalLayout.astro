---
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Mostrado como "Última atualização"; chega como `Date` (YAML sem aspas) ou `string` em `YYYY-MM-DD`. */
    updated: string | Date;
  };
}

const { title, description, updated } = Astro.props.frontmatter;
// O YAML sem aspas (`updated: 2026-10-15`) é convertido para `Date` pelo frontmatter,
// por isso `${updated}T00:00:00Z` gerava "Invalid Date". Aceitar ambos os tipos.
const updatedDate = updated instanceof Date ? updated : new Date(`${String(updated).slice(0, 10)}T00:00:00Z`);
const isValidDate = !Number.isNaN(updatedDate.getTime());
const updatedIso = isValidDate ? updatedDate.toISOString().slice(0, 10) : String(updated);
---

<BaseLayout title={title} description={description} noindex closing={false}>
  <header class="shell pt-16 sm:pt-24">
    <p class="rise eyebrow">Legal</p>
    <h1 class="rise mt-6 text-headline" style="--rise-step: 1">
      {title}
    </h1>
    <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
      {description}
    </p>
    <p class="rise mt-4 text-sm text-muted" style="--rise-step: 2">
      Última atualização{' '}
      <time datetime={updatedIso}>
        {isValidDate
          ? updatedDate.toLocaleDateString(siteConfig.dateLocale, { dateStyle: 'long', timeZone: 'UTC' })
          : updatedIso}
      </time>
    </p>
  </header>
  <div class="shell mt-14 sm:mt-20">
    <div class="prose border-t border-line pt-10">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
</style>
