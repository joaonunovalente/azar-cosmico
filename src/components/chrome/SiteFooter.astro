---
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { closing } from '@/config/home';
import { legalLinks, navigation, siteConfig } from '@/config/site';
import { socialIcon } from '@/lib/socials';
import { getAppVersion } from '@/lib/version';

interface Props {
  closing?: boolean;
}

const { closing: showClosing = true } = Astro.props;
const year = new Date().getFullYear();
const appVersion = getAppVersion();
const versionTitle = appVersion.commitSha
  ? `Versão ${appVersion.version}, commit ${appVersion.commitSha}`
  : `Versão ${appVersion.version}`;
---

{showClosing && (
  <section class="shell mt-24 sm:mt-32" aria-labelledby="closing-title">
    <div class="relative overflow-hidden rounded-[2rem] bg-night px-6 py-14 text-night-ink sm:px-12 sm:py-20 lg:px-20 lg:py-24">
      <div class="closing-grid" aria-hidden="true" />
      <div class="relative">
        <p class="eyebrow text-night-muted">{closing.eyebrow}</p>
        <h2 id="closing-title" class="mt-6 max-w-[18ch] text-headline">
          {closing.title} <span class="serif text-accent">{closing.highlight}</span>
        </h2>
        <p class="mt-6 max-w-xl text-lead text-night-muted">{closing.text}</p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a class="btn btn-accent" href="/ouvir/">
            Como ouvir
            <Icon name="arrow-up-right" class="icon-nudge-diagonal size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<footer class="mt-24 border-t border-line sm:mt-32">
  <div class="shell grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a
        href="/"
        class="inline-flex min-w-0 shrink-0 items-center gap-3 text-[1.4rem] font-semibold tracking-[-0.03em]"
      >
        <Logomark class="size-9" />
        <span class="inline-flex h-9 items-center truncate leading-none">{siteConfig.name}</span>
        <span class="sr-only">, página inicial</span>
      </a>
      <p class="mt-5 max-w-xs text-muted">
        Podcast de comédia, improviso e cultura, por João Guilherme Matos. Novos episódios aos domingos, quinzenalmente.
      </p>
    </div>

    <nav aria-labelledby="footer-pages">
      <h2 id="footer-pages" class="text-sm font-medium text-muted">
        Páginas
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {navigation.map((link) => (
          <li>
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="text-sm font-medium text-muted">
        O podcast
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-link inline-flex items-center gap-2.5" href={social.href} rel="me noopener">
              <Icon name={socialIcon(social.label)} class="size-3.5" />
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="text-sm font-medium text-muted">
        Legal
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {legalLinks.map((link) =>
          link.href.startsWith('http') ? (
            <li>
              <a class="footer-link inline-flex items-center gap-1.5" href={link.href} target="_blank" rel="noopener">
                {link.label}
                <Icon name="arrow-up-right" class="icon-nudge-diagonal size-3.5" />
                <span class="sr-only">(abre numa nova aba)</span>
              </a>
            </li>
          ) : (
            <li>
              <a class="footer-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
  </div>

  <div class="shell grid gap-4 border-t border-line py-6 text-sm text-muted sm:grid-cols-[1fr_auto_1fr] sm:items-center">
    <p class="sm:justify-self-start">
      &copy; {year}{' '}
      <a class="inline-flex items-center gap-1.5 hover:text-ink" href={siteConfig.author.href}>
        {siteConfig.author.name}
      </a>
      {'.'}
    </p>
    <p class="sm:justify-self-center">
      Desenvolvido por{' '}
      <a class="inline-flex items-center gap-1.5 hover:text-ink" href={siteConfig.developer.href}>
        {siteConfig.developer.name}
      </a>
    </p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 sm:justify-self-end">
      <a
        href="/registo-de-alteracoes/"
        class="inline-flex items-center gap-1.5 hover:text-ink"
        title={versionTitle}
        aria-label={versionTitle}
      >
        {appVersion.label}
      </a>
      <a href="#content" class="inline-flex items-center gap-1.5 hover:text-ink">
        Voltar ao topo
        <Icon name="arrow-up" class="size-3.5" />
      </a>
    </div>
  </div>
</footer>
