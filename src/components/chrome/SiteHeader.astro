---
import ThemeToggle from '@/components/chrome/ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { navigation, siteConfig } from '@/config/site';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header sticky top-0 z-40 h-(--header-h) border-b border-transparent bg-canvas">
  <div class="shell flex h-full items-center gap-4">
    <a
      href="/"
      class="flex min-w-0 shrink-0 items-center gap-3 rounded-lg text-[1.4rem] font-semibold tracking-[-0.03em]"
    >
      <Logomark class="size-9" />
      <span class="inline-flex h-9 items-center truncate leading-none">{siteConfig.name}</span>
      <span class="sr-only">, página inicial</span>
    </a>

    <nav aria-label="Principal" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {navigation.map((link) => (
          <li>
            <a href={link.href} class="nav-link" aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-3">
      <ThemeToggle />
      <a class="btn btn-primary btn-sm ml-1 hidden sm:inline-flex" href={siteConfig.action.href}>
        {siteConfig.action.label}
      </a>
      <button
        type="button"
        class="grid size-12 place-items-center rounded-full hover:bg-sunken md:hidden"
        commandfor="mobile-nav"
        command="show-modal"
        aria-haspopup="dialog"
        aria-label="Abrir menu"
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" aria-label="Menu" class="mobile-nav md:hidden">
    <div class="shell flex h-(--header-h) items-center justify-between border-b border-transparent">
      <a href="/" class="flex min-w-0 shrink-0 items-center gap-3 text-[1.4rem] font-semibold tracking-[-0.03em]">
        <Logomark class="size-9" />
        <span class="inline-flex h-9 items-center truncate leading-none">{siteConfig.name}</span>
        <span class="sr-only">, página inicial</span>
      </a>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <button
          type="button"
          class="grid size-12 place-items-center rounded-full hover:bg-sunken"
          commandfor="mobile-nav"
          command="close"
          aria-label="Fechar menu"
        >
          <Icon name="x" class="size-6" />
        </button>
      </div>
    </div>
    <nav aria-label="Menu móvel" class="shell mt-4">
      <ul class="grid">
        <li>
          <a href="/" class="mobile-link" aria-current={path === '/' ? 'page' : undefined}>
            Início
          </a>
        </li>
        {navigation.map((link) => (
          <li>
            <a href={link.href} class="mobile-link" aria-current={current(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="shell mobile-cta mt-8">
      <a class="btn btn-primary w-full" href={siteConfig.action.href}>
        {siteConfig.action.label}
      </a>
    </div>
  </dialog>
</header>

<script>
  const menu = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  if (menu && !('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('[commandfor="mobile-nav"]').forEach((button) => {
      button.addEventListener('click', () =>
        button.getAttribute('command') === 'close' ? menu.close() : menu.showModal(),
      );
    });
  }

  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.close();
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', (event) => event.matches && menu?.close());

  const header = document.querySelector('.site-header');
  if (header) {
    let ticking = false;
    const update = () => {
      ticking = false;
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    update();
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
  }
</script>

<style>
  .site-header {
    transition: border-color 200ms ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line-strong);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.6rem 1.2rem;
    color: var(--body);
    font-size: 1.1rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 1.2rem;
    bottom: 0.35rem;
    left: 1.2rem;
    height: 2px;
    border-radius: 999px;
    background: currentcolor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current] {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after {
      transition: none;
    }
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    background: var(--canvas);
    color: var(--ink);
  }

  .mobile-nav::backdrop {
    background: var(--canvas);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .mobile-link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.25em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 220ms ease,
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }

    .mobile-nav::backdrop {
      transition:
        opacity 220ms ease,
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }

    .mobile-nav nav,
    .mobile-nav .mobile-cta {
      transition: translate 320ms var(--ease-out-expo);
    }

    .mobile-nav:not([open]),
    .mobile-nav:not([open])::backdrop {
      opacity: 0;
    }

    .mobile-nav:not([open]) nav,
    .mobile-nav:not([open]) .mobile-cta {
      translate: 0 -0.75rem;
    }

    @starting-style {
      .mobile-nav[open] {
        opacity: 0;
      }

      .mobile-nav[open]::backdrop {
        opacity: 0;
      }

      .mobile-nav[open] nav,
      .mobile-nav[open] .mobile-cta {
        translate: 0 -0.75rem;
      }
    }
  }
</style>
